    {
      "id": "nested.depth_limit",
      "kind": "resolve",
      "msg": {
        "key": "g.loop",
        "args": {
          "x": {
            "key": "g.loop",
            "args": {
              "x": {
                "key": "g.loop",
                "args": {
                  "x": {
                    "key": "g.loop",
                    "args": {
                      "x": {
                        "key": "g.loop",
                        "args": {
                          "x": {
                            "key": "g.loop",
                            "args": {
                              "x": {
                                "key": "g.loop",
                                "args": {
                                  "x": {
                                    "key": "g.loop",
                                    "args": {
                                      "x": {
                                        "key": "g.loop",
                                        "args": {
                                          "x": {
                                            "key": "g.loop",
                                            "args": {
                                              "x": {
                                                "key": "g.loop",
                                                "args": {
                                                  "x": {
                                                    "key": "g.loop",
                                                    "args": {
                                                      "x": "end"
                                                    }
                                                  }
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "lang": "en",
      "expected": "[[[[[[[[[[[g.loop]]]]]]]]]]]"
    },
    {
