{
  "_about": "Shared test vectors for src/shared/Loc.luau + Msg.luau (tests/i18n.spec.luau) and i18n/loc.js (i18n/test_golden.mjs). Both must pass every case. The strings table here is separate from i18n/strings.csv so copy edits never break it.",
  "strings": {
    "g.hello": {
      "en": "Hello, {name}!",
      "ko": "안녕, {name}!"
    },
    "g.en_only": {
      "en": "Only English"
    },
    "g.empty_ko": {
      "en": "Empty Korean",
      "ko": ""
    },
    "g.days.one": {
      "en": "{count} day left"
    },
    "g.days.other": {
      "en": "{count} days left",
      "ko": "{count}일 남음"
    },
    "g.items.other": {
      "en": "{count} items",
      "ko": "{count}개"
    },
    "g.apples.one": {
      "en": "{count} apple"
    },
    "g.apples.other": {
      "en": "{count} apples"
    },
    "g.count_base": {
      "en": "Count is {count}",
      "ko": "개수 {count}"
    },
    "g.outer": {
      "en": "Found {thing}.",
      "ko": "{thing} 발견."
    },
    "g.thing": {
      "en": "ice",
      "ko": "얼음"
    },
    "g.loop": {
      "en": "[{x}]"
    },
    "g.bold.rich": {
      "en": "Hi <b>{name}</b>!",
      "ko": "<b>{name}</b> 안녕!"
    },
    "g.inner.rich": {
      "en": "<b>{v}</b>"
    },
    "g.wrap.rich": {
      "en": "Got {item}"
    },
    "g.plain_wrap": {
      "en": "Say {x}"
    },
    "g.source": {
      "en": "NASA DONKI record, {date}",
      "ko": "NASA DONKI 기록, {date}"
    },
    "date.month.8": {
      "en": "August",
      "ko": "8월"
    },
    "date.month.12": {
      "en": "December",
      "ko": "12월"
    },
    "date.month_short.8": {
      "en": "Aug",
      "ko": "8월"
    },
    "date.month_short.12": {
      "en": "Dec",
      "ko": "12월"
    },
    "fmt.date.short": {
      "en": "{month_short} {day}",
      "ko": "{month_short} {day}일"
    },
    "fmt.date.long": {
      "en": "{month_name} {day}, {year}",
      "ko": "{year}년 {month_name} {day}일"
    },
    "fmt.list.two": {
      "en": "{a} and {b}",
      "ko": "{a}, {b}"
    },
    "fmt.list.start": {
      "en": "{a}, {b}",
      "ko": "{a}, {b}"
    },
    "fmt.list.middle": {
      "en": "{a}, {b}",
      "ko": "{a}, {b}"
    },
    "fmt.list.end": {
      "en": "{a}, and {b}",
      "ko": "{a}, {b}"
    }
  },
  "cases": [
    {
      "id": "basic.en",
      "kind": "resolve",
      "msg": {
        "key": "g.hello",
        "args": {
          "name": "Mia"
        }
      },
      "lang": "en",
      "expected": "Hello, Mia!"
    },
    {
      "id": "basic.ko",
      "kind": "resolve",
      "msg": {
        "key": "g.hello",
        "args": {
          "name": "Mia"
        }
      },
      "lang": "ko",
      "expected": "안녕, Mia!"
    },
    {
      "id": "basic.string_key",
      "kind": "resolve",
      "msg": "g.thing",
      "lang": "ko",
      "expected": "얼음"
    },
    {
      "id": "fallback.ko_missing",
      "kind": "resolve",
      "msg": {
        "key": "g.en_only"
      },
      "lang": "ko",
      "expected": "Only English"
    },
    {
      "id": "fallback.ko_empty_cell",
