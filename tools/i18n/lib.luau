--!strict
-- 다국어 CSV 도구 공용 로직 (Lune 전용, 순수 함수). docs/I18N_PLAN.md 4.3.
-- tools/i18n/build.luau(생성과 --check), tools/i18n/lint.luau(키 검사), tests/i18n.spec.luau가 함께 쓴다.
--
-- CSV 규칙
-- - UTF-8, RFC 4180(쉼표 구분, 큰따옴표로 감싸기, 칸 안의 큰따옴표는 ""). 맨 앞 BOM은 무시한다.
-- - 머리글은 정확히 key,en,ko,args,note,max_len.
-- - 칸 안 줄바꿈은 두 글자 \n 으로 쓴다(실제 줄바꿈은 오류). 생성물에서는 진짜 줄바꿈이 된다.
-- - args: en 문구의 자리표시자 이름 목록. "{count} {points}" 또는 "count points"처럼 쓴다.
-- - 복수형: key.one(en에서 count == 1), key.other(그 밖, ko는 항상 other). ko는 .one 칸을 비워 둔다.
-- - .rich 가 들어간 키만 <b></b> 태그를 쓸 수 있다.

local Lib = {}

Lib.HEADER = { "key", "en", "ko", "args", "note", "max_len" }
Lib.LANGS = { "en", "ko" }
Lib.GENERATED_LINE = "-- GENERATED by tools/i18n/build.luau, do not edit"
Lib.CSV_PATH = "i18n/strings.csv"
Lib.LUAU_PATH = "src/shared/Strings.luau"
Lib.JSON_PATH = "i18n/strings.json"

-- 금지 문자 (전역 타이포그래피 규칙). 소스에는 코드포인트로만 적는다.
Lib.BANNED = {
    [0x2014] = "em dash",
    [0x2013] = "en dash",
    [0x2015] = "horizontal bar",
    [0x2212] = "minus sign",
    [0x00B7] = "middle dot",
    [0x2022] = "bullet",
    [0x2027] = "hyphenation point",
    [0x2219] = "bullet operator",
    [0x30FB] = "katakana middle dot",
}

-- 키 첫 마디(도메인). 목록 밖이면 경고만 한다 (I18N_PLAN 4.2).
Lib.KNOWN_DOMAINS = {
    hud = true,
    mission = true,
    toast = true,
    banner = true,
    prompt = true,
    panel = true,
    sign = true,
    map = true,
    role = true,
    tip = true,
    fact = true,
    result = true,
    score = true,
    medal = true,
    record = true,
    title = true,
    settings = true,
    mission_select = true,
    event = true,
    ["end"] = true,
    facility = true,
    res = true,
    unit = true,
    key = true,
    date = true,
    fmt = true,
    world = true, -- 3D 표지와 이름표 (MissionWorld TextKey)
}

-- 자리표시자 바로 뒤에 오면 받침에 따라 모양이 바뀌는 조사의 첫 글자 (경고용)
local PARTICLE_STARTS = {
    "을",
    "를",
    "이",
    "가",
    "은",
    "는",
    "와",
    "과",
    "으",
    "로",
    "랑",
}

-- 자리표시자 이름: 소문자로 시작, 영문, 숫자, 밑줄 (Rules가 perDay 같은 camelCase 값 이름을 쓴다)
local PLACEHOLDER_NAME = "^[a-z][A-Za-z0-9_]*$"

-- max_len 계산 때 자리표시자 하나를 몇 글자로 볼지
Lib.PLACEHOLDER_WIDTH = 3

export type Record = { fields: { string }, line: number }
export type Issue = { line: number, key: string, message: string }
export type Row = {
    line: number,
    key: string,
    en: string, -- \n 을 실제 줄바꿈으로 바꾼 값
    ko: string,
    args: { string },
    note: string,
    maxLen: number?,
}
export type Result = {
    rows: { Row },
    errors: { Issue },
    warnings: { Issue },
}

-- RFC 4180 파서. 빈 줄은 건너뛴다. 문법 오류는 issues로 돌려주고 가능한 만큼 읽는다.
function Lib.parseCsv(text: string): ({ Record }, { Issue })
    local records: { Record } = {}
    local issues: { Issue } = {}
    if string.sub(text, 1, 3) == "\239\187\191" then
        text = string.sub(text, 4)
    end

    local n = #text
    local i = 1
    local line = 1
    local recordLine = 1
    local fields: { string } = {}
    local field: { string } = {}
    local quoted = false -- 지금 칸이 큰따옴표로 시작했는지
    local inQuotes = false
    local closed = false -- 따옴표 칸이 닫힌 뒤인지

    local function issue(message: string)
        table.insert(issues, { line = line, key = "", message = message })
    end

    local function endField()
        table.insert(fields, table.concat(field))
        field = {}
        quoted = false
        inQuotes = false
        closed = false
    end

    local function endRecord()
        endField()
        if not (#fields == 1 and fields[1] == "") then
            table.insert(records, { fields = fields, line = recordLine })
        end
        fields = {}
    end

    while i <= n do
        local c = string.sub(text, i, i)
        if inQuotes then
            if c == '"' then
                if string.sub(text, i + 1, i + 1) == '"' then
                    table.insert(field, '"')
                    i += 2
                else
                    inQuotes = false
                    closed = true
                    i += 1
                end
                continue
            end
            if c == "\n" or (c == "\r" and string.sub(text, i + 1, i + 1) ~= "\n") then
                line += 1
            end
            table.insert(field, c)
            i += 1
            continue
        end
        if c == "," then
            endField()
            i += 1
        elseif c == "\r" or c == "\n" then
            if c == "\r" and string.sub(text, i + 1, i + 1) == "\n" then
                i += 1
            end
            endRecord()
            line += 1
            recordLine = line
            i += 1
        elseif c == '"' then
            if #field == 0 and not quoted then
                quoted = true
                inQuotes = true
            else
                issue(
                    '큰따옴표가 칸 중간에 있습니다 (칸 전체를 큰따옴표로 감싸고 "" 로 쓰세요)'
                )
                table.insert(field, c)
            end
            i += 1
        else
            if closed then
                issue("닫는 큰따옴표 뒤에 글자가 있습니다")
                closed = false
            end
            table.insert(field, c)
            i += 1
        end
    end
    if inQuotes then
        issue("큰따옴표가 닫히지 않았습니다")
    end
    if #field > 0 or #fields > 0 or quoted then
        endRecord()
    end
    return records, issues
end

-- 문구의 자리표시자 이름(나온 순서, 중복 없음)과 문법 문제 목록
function Lib.scanTemplate(template: string): ({ string }, { string })
    local names: { string } = {}
    local seen: { [string]: boolean } = {}
    local problems: { string } = {}
    local n = #template
    local i = 1
    while i <= n do
        local c = string.sub(template, i, i)
        if c == "{" then
            if string.sub(template, i + 1, i + 1) == "{" then
                i += 2
                continue
            end
            local close = string.find(template, "}", i + 1, true)
            if not close then
                table.insert(problems, "닫히지 않은 { (글자 그대로는 {{ 로 씁니다)")
                break
            end
            local name = string.sub(template, i + 1, close - 1)
            if not string.match(name, PLACEHOLDER_NAME) then
                table.insert(problems, "자리표시자 이름이 잘못됨: {" .. name .. "}")
            elseif not seen[name] then
                seen[name] = true
                table.insert(names, name)
            end
            i = close + 1
        elseif c == "}" then
            if string.sub(template, i + 1, i + 1) == "}" then
                i += 2
            else
                table.insert(problems, "짝 없는 } (글자 그대로는 }} 로 씁니다)")
                i += 1
            end
        else
            i += 1
        end
    end
    return names, problems
end

-- args 칸 읽기: "{count} {points}", "count points", "count,points" 모두 허용
function Lib.parseArgs(text: string): { string }
    local out: { string } = {}
    for token in string.gmatch(text, "[^%s,;]+") do
        local name = string.gsub(token, "^{(.*)}$", "%1")
        table.insert(out, name)
    end
    return out
end

local function setOf(list: { string }): { [string]: boolean }
    local s: { [string]: boolean } = {}
    for _, v in list do
        s[v] = true
    end
    return s
end

local function sameSet(a: { string }, b: { string }): boolean
    local sa, sb = setOf(a), setOf(b)
    for k in sa do
        if not sb[k] then
            return false
        end
    end
    for k in sb do
        if not sa[k] then
            return false
        end
    end
    return true
end

local function sortedJoin(list: { string }): string
    local copy = table.clone(list)
    table.sort(copy)
    if #copy == 0 then
        return "(없음)"
    end
    return "{" .. table.concat(copy, "} {") .. "}"
end

-- UTF-8이 아니면 nil, 맞으면 코드포인트 목록
local function codepoints(text: string): { number }?
    if utf8.len(text) == nil then
        return nil
    end
    local out: { number } = {}
    for _, cp in utf8.codes(text) do
        table.insert(out, cp)
    end
    return out
end

-- 화면 글자 수 (자리표시자는 PLACEHOLDER_WIDTH 글자, {{ }} 는 1글자)
function Lib.displayLength(template: string): number
    local stripped = string.gsub(template, "{{", "{")
    stripped = string.gsub(stripped, "}}", "}")
    local count = 0
    stripped = string.gsub(stripped, "{[%w_]+}", function()
        count += 1
        return ""
    end)
    return (utf8.len(stripped) or #stripped) + count * Lib.PLACEHOLDER_WIDTH
end

function Lib.isRichKey(key: string): boolean
    return string.find("." .. key .. ".", ".rich.", 1, true) ~= nil
end

-- 키의 마지막 마디가 one/other면 (기본 키, 형태)
function Lib.pluralParts(key: string): (string?, string?)
    local base, form = string.match(key, "^(.+)%.(%a+)$")
    if base and (form == "one" or form == "other") then
        return base, form
    end
    return nil, nil
end

-- 굵게 태그 검사: .rich 키는 <b></b>만, 그 밖의 키는 태그 금지
local function markupProblem(key: string, text: string): string?
    local rich = Lib.isRichKey(key)
    local depth = 0
    for tag in string.gmatch(text, "<(/?%a[^>]*)>") do
        if not rich then
            return "태그 <" .. tag .. "> 는 .rich 키에서만 씁니다"
        end
        if tag == "b" then
            depth += 1
        elseif tag == "/b" then
            depth -= 1
            if depth < 0 then
                return "</b> 가 <b> 보다 먼저 나옵니다"
            end
        else
            return "허용하지 않는 태그 <" .. tag .. "> (.rich 키는 <b></b>만)"
        end
    end
    if depth ~= 0 then
        return "<b> 와 </b> 짝이 맞지 않습니다"
    end
    return nil
end

local function unescapeCell(text: string): string
    return (string.gsub(text, "\\n", "\n"))
end

-- 출력 순서를 고정한다 (줄, 키, 메시지 순)
local function issueLess(a: Issue, b: Issue): boolean
    if a.line ~= b.line then
        return a.line < b.line
    end
    if a.key ~= b.key then
        return a.key < b.key
    end
    return a.message < b.message
end

-- 레코드를 행으로 바꾸고 검사한다. errors가 하나라도 있으면 생성하지 않는다.
function Lib.validate(records: { Record }, parseIssues: { Issue }?): Result
    local errors: { Issue } = {}
    local warnings: { Issue } = {}
    local rows: { Row } = {}
    for _, problem in parseIssues or {} do
        table.insert(errors, problem)
    end

    local function err(line: number, key: string, message: string)
        table.insert(errors, { line = line, key = key, message = message })
    end
    local function warn(line: number, key: string, message: string)
        table.insert(warnings, { line = line, key = key, message = message })
    end

    if #records == 0 then
        err(1, "", "CSV가 비어 있습니다")
        return { rows = rows, errors = errors, warnings = warnings }
    end

    local header = records[1]
    if table.concat(header.fields, ",") ~= table.concat(Lib.HEADER, ",") then
        err(
            header.line,
            "",
            "머리글은 " .. table.concat(Lib.HEADER, ",") .. " 이어야 합니다"
        )
        return { rows = rows, errors = errors, warnings = warnings }
    end

    local seenKeys: { [string]: number } = {}
    for index = 2, #records do
        local record = records[index]
        local f = record.fields
        local line = record.line
        local key = f[1] or ""
        if #f ~= #Lib.HEADER then
            err(line, key, string.format("칸이 %d개 (기대 %d개)", #f, #Lib.HEADER))
            continue
        end

        -- 모든 칸: UTF-8, 금지 문자, 실제 줄바꿈과 탭
        local cellOk = true
        for col, value in f do
            local cps = codepoints(value)
            if cps == nil then
                err(line, key, Lib.HEADER[col] .. " 칸이 UTF-8이 아닙니다")
                cellOk = false
                continue
            end
            for _, cp in cps do
                local name = Lib.BANNED[cp]
                if name then
                    err(
                        line,
                        key,
                        string.format(
                            "%s 칸에 금지 문자 U+%04X (%s), ASCII '-' 나 쉼표를 쓰세요",
                            Lib.HEADER[col],
                            cp,
                            name
                        )
                    )
                    cellOk = false
                end
            end
            if string.find(value, "[\r\n\t]") then
                err(
                    line,
                    key,
                    Lib.HEADER[col]
                        .. " 칸에 실제 줄바꿈이나 탭이 있습니다 (줄바꿈은 \\n 두 글자)"
                )
                cellOk = false
            end
        end

        if
            not string.match(key, "^[a-z][a-z0-9_]*%.[a-z0-9_.]+$")
            or string.find(key, "..", 1, true)
            or string.sub(key, -1) == "."
        then
            err(
                line,
                key,
                "키 형식은 domain.area.name (소문자, 숫자, 밑줄, 점)입니다"
            )
            continue
        end
        if seenKeys[key] then
            err(line, key, string.format("중복 키 (%d번째 줄에도 있음)", seenKeys[key]))
            continue
        end
        seenKeys[key] = line

        local domain = string.match(key, "^([a-z0-9_]+)") :: string
        if not Lib.KNOWN_DOMAINS[domain] then
            warn(line, key, "목록에 없는 도메인 '" .. domain .. "' (I18N_PLAN 4.2)")
        end

        local enRaw, koRaw = f[2], f[3]
        local args = Lib.parseArgs(f[4])
        local maxLen: number? = nil
        if f[6] ~= "" then
            local parsed = tonumber(f[6])
            if parsed == nil or parsed < 1 or parsed % 1 ~= 0 then
                err(line, key, "max_len은 1 이상의 정수입니다: " .. f[6])
            else
                maxLen = parsed
            end
        end

        if enRaw == "" then
            err(line, key, "en이 비어 있습니다")
        end

        local enNames, enProblems = Lib.scanTemplate(enRaw)
        for _, p in enProblems do
            err(line, key, "en: " .. p)
        end
        local koNames, koProblems = Lib.scanTemplate(koRaw)
        for _, p in koProblems do
            err(line, key, "ko: " .. p)
        end
        for _, name in args do
            if not string.match(name, PLACEHOLDER_NAME) then
                err(line, key, "args의 이름이 잘못됨: " .. name)
            end
        end

        if enRaw ~= "" and #enProblems == 0 and not sameSet(enNames, args) then
            err(
                line,
                key,
                string.format(
                    "args 칸 %s 과 en 자리표시자 %s 가 다릅니다",
                    sortedJoin(args),
                    sortedJoin(enNames)
                )
            )
        end
        if
            koRaw ~= ""
            and #koProblems == 0
            and #enProblems == 0
            and not sameSet(enNames, koNames)
        then
            err(
                line,
                key,
                string.format(
                    "언어 간 자리표시자가 다릅니다: en %s, ko %s",
                    sortedJoin(enNames),
                    sortedJoin(koNames)
                )
            )
        end

        for _, pair in { { "en", enRaw }, { "ko", koRaw } } do
            local lang, text = pair[1], pair[2]
            if string.find(text, "%%[sdif%%]") then
                err(
                    line,
                    key,
                    lang .. ": %d, %s 형식은 폐지되었습니다. {name} 을 쓰세요"
                )
            end
            local problem = markupProblem(key, text)
            if problem then
                err(line, key, lang .. ": " .. problem)
            end
            if text ~= "" and (string.match(text, "^%s") or string.match(text, "%s$")) then
                warn(line, key, lang .. ": 앞이나 뒤에 공백이 있습니다")
            end
        end

        local _, form = Lib.pluralParts(key)
        if koRaw == "" and form ~= "one" then
            warn(line, key, "ko 번역이 없습니다 (화면에는 en이 나옵니다)")
        end

        if koRaw ~= "" then
            for _, start in PARTICLE_STARTS do
                if string.find(koRaw, "}" .. start, 1, true) then
                    warn(
                        line,
                        key,
                        "ko: 자리표시자 바로 뒤에 조사 '"
                            .. start
                            .. "' (받침에 따라 틀릴 수 있음, '{name} 님이', '{key} 키를'처럼 고정 명사를 붙이세요)"
                    )
                    break
                end
            end
        end

        if maxLen then
            for _, pair in { { "en", enRaw }, { "ko", koRaw } } do
                local lang, text = pair[1], pair[2]
                if text ~= "" then
                    local length = Lib.displayLength(unescapeCell(text))
                    if length > maxLen then
                        warn(
                            line,
                            key,
                            string.format("%s: 길이 %d > max_len %d", lang, length, maxLen)
                        )
                    end
                end
            end
        end

        if cellOk then
            table.insert(rows, {
                line = line,
                key = key,
                en = unescapeCell(enRaw),
                ko = unescapeCell(koRaw),
                args = args,
                note = f[5],
                maxLen = maxLen,
            })
        end
    end

    -- 행 사이 검사: 복수형 짝, 기본 키와 복수형 키를 같이 두지 않기
    for key, line in seenKeys do
        local base, form = Lib.pluralParts(key)
        if base and form == "one" and not seenKeys[base .. ".other"] then
            err(line, key, "복수형 " .. base .. ".other 가 없습니다")
        end
        if base and seenKeys[base] then
            err(
                line,
                key,
                "기본 키 " .. base .. " 와 복수형 키를 함께 둘 수 없습니다"
            )
        end
    end

    table.sort(errors, issueLess)
    table.sort(warnings, issueLess)
    return { rows = rows, errors = errors, warnings = warnings }
end

-- CSV 텍스트 한 번에 검사
function Lib.load(text: string): Result
    local records, issues = Lib.parseCsv(text)
    return Lib.validate(records, issues)
end

local function sortedRows(rows: { Row }): { Row }
    local copy = table.clone(rows)
    table.sort(copy, function(a, b)
        return a.key < b.key
    end)
    return copy
end

-- Luau 문자열 리터럴 (ASCII 제어 문자와 따옴표, 역슬래시만 이스케이프, 한글은 그대로)
function Lib.luauString(text: string): string
    local escaped = string.gsub(text, '[%c"\\]', function(c: string): string
        if c == "\n" then
            return "\\n"
        elseif c == "\t" then
            return "\\t"
        elseif c == "\r" then
            return "\\r"
        elseif c == '"' then
            return '\\"'
        elseif c == "\\" then
            return "\\\\"
        end
        return string.format("\\%03d", string.byte(c))
    end)
    return '"' .. escaped .. '"'
end

-- JSON 문자열 (한글은 UTF-8 그대로)
function Lib.jsonString(text: string): string
    local escaped = string.gsub(text, '[%c"\\]', function(c: string): string
        if c == "\n" then
            return "\\n"
        elseif c == "\t" then
            return "\\t"
        elseif c == "\r" then
            return "\\r"
        elseif c == '"' then
            return '\\"'
        elseif c == "\\" then
            return "\\\\"
        end
        return string.format("\\u%04x", string.byte(c))
    end)
    return '"' .. escaped .. '"'
end

-- src/shared/Strings.luau 내용 (키 정렬, stylua가 바꾸지 않는 형태)
function Lib.generateLuau(rows: { Row }): string
    local out = {
        Lib.GENERATED_LINE,
        "--!strict",
        "-- 원본은 i18n/strings.csv. 문구를 고칠 때는 CSV를 고치고 저장소 루트에서",
        "-- lune run tools/i18n/build.luau 를 실행한다. 웹판은 같은 내용의 i18n/strings.json을 쓴다.",
        "-- 해석은 Shared.Loc(클라이언트는 Localizer)만 한다. 서버는 키와 값(Msg)만 보낸다.",
        "",
        "export type Entry = { en: string, ko: string? }",
        "",
        "local Strings = {}",
        "",
        "-- 지원 언어 (첫 번째가 기본이자 대체 언어)",
        'Strings.languages = { "en", "ko" }',
        "",
        "-- stylua: ignore",
        "local STRINGS: { [string]: Entry } = {",
    }
    for _, row in sortedRows(rows) do
        local parts = { "en = " .. Lib.luauString(row.en) }
        if row.ko ~= "" then
            table.insert(parts, "ko = " .. Lib.luauString(row.ko))
        end
        table.insert(
            out,
            "    [" .. Lib.luauString(row.key) .. "] = { " .. table.concat(parts, ", ") .. " },"
        )
    end
    table.insert(out, "}")
    table.insert(out, "")
    table.insert(out, "Strings.strings = STRINGS")
    table.insert(out, "Strings.count = " .. tostring(#rows))
    table.insert(out, "")
    table.insert(out, "return Strings")
    table.insert(out, "")
    return table.concat(out, "\n")
end

-- i18n/strings.json 내용 (웹판용, 키 정렬)
function Lib.generateJson(rows: { Row }): string
    local out = {
        "{",
        '  "_generated": "GENERATED by tools/i18n/build.luau from i18n/strings.csv, do not edit",',
        '  "languages": ["en", "ko"],',
        '  "fallback": "en",',
        '  "count": ' .. tostring(#rows) .. ",",
        '  "strings": {',
    }
    local sorted = sortedRows(rows)
    for index, row in sorted do
        local parts = { '"en": ' .. Lib.jsonString(row.en) }
        if row.ko ~= "" then
            table.insert(parts, '"ko": ' .. Lib.jsonString(row.ko))
        end
        local comma = if index < #sorted then "," else ""
        table.insert(
            out,
            "    "
                .. Lib.jsonString(row.key)
                .. ": { "
                .. table.concat(parts, ", ")
                .. " }"
                .. comma
        )
    end
    table.insert(out, "  }")
    table.insert(out, "}")
    table.insert(out, "")
    return table.concat(out, "\n")
end

-- 도메인(첫 마디)별 행 수, 이름 순
function Lib.countByDomain(rows: { Row }): { { domain: string, count: number } }
    local counts: { [string]: number } = {}
    for _, row in rows do
        local domain = string.match(row.key, "^([a-z0-9_]+)") or "?"
        counts[domain] = (counts[domain] or 0) + 1
    end
    local out = {}
    for domain, count in counts do
        table.insert(out, { domain = domain, count = count })
    end
    table.sort(out, function(a, b)
        return a.domain < b.domain
    end)
    return out
end

function Lib.formatIssue(issue: Issue): string
    local where = Lib.CSV_PATH .. ":" .. tostring(issue.line)
    if issue.key ~= "" then
        where ..= " [" .. issue.key .. "]"
    end
    return where .. " " .. issue.message
end

-- ===== 소스 검사 (tools/i18n/lint.luau) =====

-- 로그 호출. warnOnce(key, message)와 safe(label, fn)는 MissionWorld의 로그 래퍼다 (둘 다 warn으로만 출력).
-- 다른 로그 래퍼를 만들면 이름을 여기에 더한다. 화면 문구를 내는 함수 이름은 넣지 않는다.
local LOG_CALLS = {
    print = true,
    warn = true,
    error = true,
    assert = true,
    warnOnce = true,
    safe = true,
}
Lib.LOG_CALLS = LOG_CALLS

local KEYWORDS = {
    ["and"] = true,
    ["break"] = true,
    ["do"] = true,
    ["else"] = true,
    ["elseif"] = true,
    ["end"] = true,
    ["false"] = true,
    ["for"] = true,
    ["function"] = true,
    ["if"] = true,
    ["in"] = true,
    ["local"] = true,
    ["nil"] = true,
    ["not"] = true,
    ["or"] = true,
    ["repeat"] = true,
    ["return"] = true,
    ["then"] = true,
    ["true"] = true,
    ["until"] = true,
    ["while"] = true,
    ["continue"] = true,
}

export type Literal = {
    line: number,
    text: string, -- 리터럴 안의 원문 (이스케이프는 풀지 않음)
    inLog: boolean, -- print, warn, error, assert 호출 안
    callee: string?, -- 바로 감싼 호출 이름 (예: "Msg.new")
    argIndex: number, -- 그 호출의 몇 번째 인자인지 (1부터)
    field: string?, -- { key = "..." } 처럼 표 필드 값이면 필드 이름
}

type Frame = { callee: string?, args: number }

-- Luau 소스에서 문자열 리터럴과 감싼 호출을 찾는다 (가벼운 토크나이저, 주석 건너뜀)
function Lib.scanLuau(source: string): { Literal }
    local literals: { Literal } = {}
    local n = #source
    local i = 1
    local line = 1
    local stack: { Frame } = {}
    local chain: string? = nil -- 직전 이름 사슬 (a.b:c)
    local chainOpen = false -- 사슬 끝이 . 이나 : 라서 이름을 더 기다리는 중
    local lastName: string? = nil -- 직전 토큰이 이름이면 그 이름 (표 필드 판정용)
    local pendingField: string? = nil -- name = 다음 값이면 필드 이름

    local function inLog(): boolean
        for _, frame in stack do
            if frame.callee and LOG_CALLS[frame.callee] then
                return true
            end
        end
        return false
    end

    local function countLines(text: string)
        local _, newlines = string.gsub(text, "\n", "")
        line += newlines
    end

    local function addLiteral(text: string, startLine: number, directCall: string?)
        local top = stack[#stack]
        local literal: Literal = {
            line = startLine,
            text = text,
            inLog = inLog() or (directCall ~= nil and LOG_CALLS[directCall] == true),
            callee = directCall or (if top then top.callee else nil),
            argIndex = if directCall then 1 else (if top then top.args + 1 else 0),
            field = pendingField,
        }
        table.insert(literals, literal)
    end

    -- 긴 괄호 [[ ]], [==[ ]==] 의 끝. 반환: 내용, 다음 위치
    local function longBracket(at: number): (string?, number)
        local eq = string.match(source, "^%[(=*)%[", at)
        if not eq then
            return nil, at
        end
        local open = 2 + #eq
        local closeToken = "]" .. eq .. "]"
        local stop = string.find(source, closeToken, at + open, true)
        if not stop then
            return string.sub(source, at + open), n + 1
        end
        return string.sub(source, at + open, stop - 1), stop + #closeToken
    end

    while i <= n do
        local c = string.sub(source, i, i)
        if c == "\n" then
            line += 1
            i += 1
        elseif string.match(c, "%s") then
            i += 1
        elseif string.sub(source, i, i + 1) == "--" then
            local content, nextPos = longBracket(i + 2)
            if content then
                countLines(content)
                i = nextPos
            else
                local stop = string.find(source, "\n", i, true) or (n + 1)
                i = stop
            end
        elseif c == '"' or c == "'" or c == "`" then
            local startLine = line
            local j = i + 1
            local parts = {}
            while j <= n do
                local d = string.sub(source, j, j)
                if d == "\\" then
                    table.insert(parts, string.sub(source, j, j + 1))
                    if string.sub(source, j + 1, j + 1) == "\n" then
                        line += 1
                    end
                    j += 2
                elseif d == c then
                    break
                elseif d == "\n" then
                    if c == "`" then
                        line += 1
                        table.insert(parts, d)
                        j += 1
                    else
                        break -- 닫히지 않은 문자열, 줄 끝에서 멈춘다
                    end
                else
                    table.insert(parts, d)
                    j += 1
                end
            end
            local directCall = if chain
                    and not chainOpen
                    and not KEYWORDS[chain]
                then chain
                else nil
            addLiteral(table.concat(parts), startLine, directCall)
            pendingField = nil
            chain, chainOpen, lastName = nil, false, nil
            i = j + 1
        elseif c == "[" and string.match(source, "^%[=*%[", i) then
            local startLine = line
            local content, nextPos = longBracket(i)
            countLines(content or "")
            local directCall = if chain
                    and not chainOpen
                    and not KEYWORDS[chain]
                then chain
                else nil
            addLiteral(content or "", startLine, directCall)
            pendingField = nil
            chain, chainOpen, lastName = nil, false, nil
            i = nextPos
        elseif string.match(c, "[%a_]") then
            local name = string.match(source, "^[%w_]+", i) :: string
            if chain and chainOpen then
                chain = chain .. name
            else
                chain = name
            end
            chainOpen = false
            lastName = name
            i += #name
        elseif c == "." or c == ":" then
            if string.sub(source, i, i + 2) == "..." then
                chain, chainOpen, lastName = nil, false, nil
                i += 3
            elseif string.sub(source, i, i + 1) == ".." then
                chain, chainOpen, lastName = nil, false, nil
                pendingField = nil
                i += 2
            elseif string.sub(source, i, i + 1) == "::" then
                chain, chainOpen, lastName = nil, false, nil
                i += 2
            else
                if chain and not chainOpen then
                    chain ..= c
                    chainOpen = true
                end
                lastName = nil
                i += 1
            end
        elseif c == "(" then
            local callee = if chain and not chainOpen and not KEYWORDS[chain] then chain else nil
            table.insert(stack, { callee = callee, args = 0 })
            chain, chainOpen, lastName = nil, false, nil
            pendingField = nil
            i += 1
        elseif c == ")" then
            table.remove(stack)
            -- 호출 결과 뒤 .x 나 : 는 이름 사슬이 아니다
            chain, chainOpen, lastName = nil, false, nil
            pendingField = nil
            i += 1
        elseif c == "{" then
            table.insert(stack, { callee = nil, args = 0 })
            chain, chainOpen, lastName = nil, false, nil
            pendingField = nil
            i += 1
        elseif c == "}" then
            table.remove(stack)
            chain, chainOpen, lastName = nil, false, nil
            pendingField = nil
            i += 1
        elseif c == "," or c == ";" then
            local top = stack[#stack]
            if top then
                top.args += 1
            end
            chain, chainOpen, lastName = nil, false, nil
            pendingField = nil
            i += 1
        elseif c == "=" then
            if string.sub(source, i, i + 1) == "==" then
                pendingField = nil
                i += 2
            else
                pendingField = lastName
                i += 1
            end
            chain, chainOpen, lastName = nil, false, nil
        else
            chain, chainOpen, lastName = nil, false, nil
            if c ~= "[" and c ~= "]" then
                pendingField = nil
            end
            i += 1
        end
    end
    return literals
end

-- 리터럴이 문구 키 사용이면 그 키, 아니면 nil (lint 키 검사).
-- 키 모양(domain.name, domain.area.name)이고 첫 마디가 KNOWN_DOMAINS에 있는 리터럴은 어디에 있든 키로 본다
-- (Msg.new 인자, key/textKey 필드, UI.msg(label, "hud.low") 같은 함수 인자 모두). 2026-11-14 src 전체에서
-- 이 모양의 리터럴은 전부 실제 키였다(오탐 0). 파일 이름처럼 도메인 단어로 시작하는 문자열("map.png")을 만들면 걸린다.
-- 끝이 점이거나 점이 두 번 이어지면 동적 키의 앞부분이라 검사하지 않는다 ("date.month." .. n).
function Lib.keyUse(literal: Literal): string?
    local text = literal.text
    if string.sub(text, -1) == "." or string.find(text, "..", 1, true) then
        return nil
    end
    local domain = string.match(text, "^([a-z][a-z0-9_]*)%.[a-z0-9_.]+$")
    if not domain or not Lib.KNOWN_DOMAINS[domain] then
        return nil
    end
    return text
end

function Lib.hasHangul(text: string): boolean
    if utf8.len(text) == nil then
        return false
    end
    for _, cp in utf8.codes(text) do
        if
            (cp >= 0xAC00 and cp <= 0xD7A3)
            or (cp >= 0x1100 and cp <= 0x11FF)
            or (cp >= 0x3130 and cp <= 0x318F)
            or (cp >= 0xA960 and cp <= 0xA97F)
            or (cp >= 0xD7B0 and cp <= 0xD7FF)
        then
            return true
        end
    end
    return false
end

return Lib
