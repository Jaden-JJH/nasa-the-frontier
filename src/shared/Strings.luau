    ["tip.airlock"] = { en = "First job: walk to the airlock and start its check. Then it can refill your oxygen.", ko = "첫 임무: 에어록으로 걸어가 점검을 시작해요. 그러면 산소를 채울 수 있어요." },
    ["tip.badge"] = { en = "Tip", ko = "팁" },
    ["tip.boost"] = { en = "Hold {key_boost} to boost. It uses the battery faster.", ko = "{key_boost} 길게 누르면 부스터가 켜져요. 배터리가 빨리 줄어요." },
    ["tip.console"] = { en = "Use the lander console to see the map and send the rover for ice.", ko = "착륙선 콘솔에서 지도를 보고 로버를 보내 얼음을 가져와요." },
    ["tip.console_team"] = { en = "Mission Control can pin an ice site on the console map. Everyone else sees an arrow.", ko = "관제사는 콘솔 지도에서 얼음 후보지에 핀을 찍을 수 있어요. 다른 대원에게는 화살표가 보여요." },
    ["tip.low_food"] = { en = "Food is getting low. Build the greenhouse to grow more food.", ko = "식량이 줄고 있어요. 그린하우스를 지어 식량을 길러요." },
    ["tip.low_water"] = { en = "Water is getting low. Send the rover to an ice site.", ko = "물이 줄고 있어요. 로버를 얼음 후보지로 보내요." },
    ["tip.low_water_team"] = { en = "Water is getting low. Drive the rover to an ice site and bring ice back.", ko = "물이 줄고 있어요. 로버를 몰고 얼음 후보지에 다녀와요." },
    ["tip.oxygen"] = { en = "Oxygen runs out outside. Go back into the lander or a working airlock to refill.", ko = "밖에서는 산소가 줄어요. 착륙선이나 가동 중인 에어록에 들어가 채워요." },
    ["tip.panels"] = { en = "Put up solar panels at the solar field. Each panel makes energy every day.", ko = "태양광 필드에 태양광 패널을 세워요. 패널은 날마다 에너지를 만들어요." },
    ["tip.pause"] = { en = "Low on energy? Pause a facility at the console or on its wall panel to save energy.", ko = "에너지가 부족하면 콘솔이나 건물 벽 제어반에서 시설을 잠시 멈춰 아껴요." },
    ["tip.pause_to_save"] = { en = "Done building? Pause LED Grow Lights and the Nutrient System to save energy for your next build. Built things still count for your medal.", ko = "다 지었나요? LED 조명과 영양분 관리를 잠시 멈추면 다음 건설에 쓸 에너지를 아낄 수 있어요. 이미 지은 시설은 그대로 메달에 들어가요." },
    ["tip.pin"] = { en = "Follow the arrow to the spot Mission Control picked.", ko = "관제사가 고른 곳까지 화살표를 따라가요." },
    ["tip.pipe"] = { en = "The water pipe is unlocked! Pick an ice site for it on the console map.", ko = "물 파이프가 열렸어요! 콘솔 지도에서 연결할 얼음 후보지를 골라요." },
    ["tip.rover_damage"] = { en = "Your rover got hurt and is slower now. Repair it at the rover park.", ko = "로버가 다쳐서 느려졌어요. 로버 주차장에서 고쳐요." },
    ["tip.sep"] = { en = "Solar storms are dangerous. When the warning shows, get inside fast!", ko = "태양 폭풍은 위험해요. 경보가 뜨면 얼른 안으로 들어가요!" },
    ["title.about.button"] = { en = "About the data", ko = "데이터 출처" },
    ["title.about.close"] = { en = "Close", ko = "닫기" },
    ["title.about.donki"] = { en = "Space weather comes from NASA DONKI, a list of real space weather events.", ko = "우주 날씨는 실제 우주 날씨 기록을 모은 NASA DONKI에서 가져왔어요." },
    ["title.about.donki_name"] = { en = "DONKI stands for Space Weather Database Of Notifications, Knowledge, Information.", ko = "DONKI는 NASA의 우주 날씨 알림, 지식, 정보 데이터베이스예요." },
    ["title.about.facts"] = { en = "Fact cards are based on public NASA information.", ko = "사실 카드는 NASA 공개 자료를 바탕으로 만들었어요." },
