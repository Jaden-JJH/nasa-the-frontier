    ["mission.a.site"] = { en = "Malapert Massif", ko = "Malapert Massif" },
    ["mission.b.desc"] = { en = "A high, flat plateau. Some spots near the pole get sunlight most of the year, good for making energy.", ko = "높고 평평한 고원이에요. 남극 근처에는 한 해 대부분 햇빛이 드는 곳이 있어 에너지를 만들기 좋아요." },
    ["mission.b.name"] = { en = "Power Base", ko = "발전 기지" },
    ["mission.b.site"] = { en = "Mons Mouton Plateau", ko = "Mons Mouton Plateau" },
    ["mission.c.desc"] = { en = "A crater rim next to dark, shadowed spots where we search for ice. Ice can give water to grow food.", ko = "얼음을 찾아볼 어두운 그늘 지역 옆의 크레이터 가장자리예요. 얼음에서 물을 얻으면 식량을 키울 수 있어요." },
    ["mission.c.name"] = { en = "Food Base", ko = "식량 생산 기지" },
    ["mission.c.site"] = { en = "Nobile Rim 1", ko = "Nobile Rim 1" },
    ["mission.d.desc"] = { en = "Its name includes Cabeus. In 2009, NASA's LCROSS found water at Cabeus crater.", ko = "이름에 Cabeus가 들어가요. 2009년 NASA의 LCROSS가 Cabeus 크레이터에서 물을 찾았어요." },
    ["mission.d.name"] = { en = "Exploration Base", ko = "탐사 기지" },
    ["mission.d.site"] = { en = "Peak near Cabeus B", ko = "Peak near Cabeus B" },
