    ["info.airlock.desc"] = { en = "After its check, it refills your Oxygen, since the Moon has no air to breathe.", ko = "점검을 마치면 산소를 다시 채워 줘요. 달에는 숨 쉴 공기가 없거든요." },
    ["info.exit.desc"] = { en = "Rovers go out here to the ice sites: dark, shadowed spots we search for ice.", ko = "로버는 여기로 나가 얼음 후보지로 가요. 얼음을 찾아볼 어둡고 그늘진 곳이에요." },
    ["info.farm.desc"] = { en = "Grows Food for the crew, since sending food from Earth is very hard.", ko = "대원들이 먹을 식량을 길러요. 지구에서 식량을 보내기는 아주 어렵거든요." },
    ["info.hydroponics.desc"] = { en = "Plants grow in water with plant food instead of soil, for a bigger harvest.", ko = "흙 대신 영양분을 푼 물에서 식물을 키워 더 많이 수확해요." },
    ["info.lander.desc"] = { en = "Your safe home on the Moon: Oxygen won't drop inside, and the console is here.", ko = "달 위의 안전한 집이에요. 안에서는 산소가 줄지 않고, 착륙선 콘솔도 여기 있어요." },
    ["info.led.desc"] = { en = "Red and blue grow lights make Food grow faster, but they use more Energy.", ko = "빨간빛과 파란빛 LED 조명이 식량을 더 빨리 자라게 해요. 대신 에너지를 더 써요." },
    ["info.nutrient.desc"] = { en = "Every drop of Water counts on the Moon, so this helps the greenhouse use less.", ko = "달에서는 물 한 방울도 소중해요. 그린하우스가 물을 덜 쓰게 도와줘요." },
    ["info.pipe.desc"] = { en = "Brings Water from one ice site by itself, so the rover can go somewhere else.", ko = "얼음 후보지 한 곳에서 물을 저절로 가져와요. 로버는 다른 곳에 갈 수 있어요." },
    ["info.pipe.next.one"] = { en = "Next water in {count} day" },
    ["info.pipe.next.other"] = { en = "Next water in {count} days", ko = "{count}일 뒤 물 도착" },
    ["info.rover_park.desc"] = { en = "Park the rover here to charge its battery with base Energy, and to fix it.", ko = "로버를 여기 세우면 기지 에너지로 배터리를 충전해요. 수리도 여기서 해요." },
    ["info.solar_field.desc"] = { en = "Solar panels here turn sunlight into Energy, the power for the whole base.", ko = "여기 태양광 패널이 햇빛을 에너지로 바꿔요. 기지 전체가 이 에너지로 움직여요." },
    ["info.solar_field.status"] = { en = "Panels built: {installed} / {total}", ko = "설치한 패널: {installed} / {total}" },
    ["info.status.farm_off"] = { en = "Not working: the Greenhouse isn't running", ko = "멈춤: 그린하우스가 가동 중이 아니에요" },
    ["info.water_tank.desc"] = { en = "Unload the rover's Water here. The crew and the greenhouse need it every day.", ko = "로버가 싣고 온 물을 여기에 내려요. 대원과 그린하우스는 날마다 물이 필요해요." },
