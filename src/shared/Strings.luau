    ["fact.artemis.body"] = { en = "Artemis is NASA's program to send astronauts on harder and harder trips to the Moon. In April 2026, four Artemis II astronauts flew around the Moon and came back to Earth. NASA now plans a Moon Base near the south pole, so people can stay a long time and prepare for trips to Mars.", ko = "아르테미스는 NASA가 우주비행사를 점점 더 어려운 달 탐사에 보내는 계획이에요. 2026년 4월에는 아르테미스 II의 우주비행사 네 명이 달 주위를 돌고 지구로 돌아왔어요. NASA는 이제 남극 근처에 달 기지를 지어, 사람이 오래 머물고 화성 탐사를 준비하려고 해요." },
    ["fact.artemis.title"] = { en = "Artemis: back to the Moon to stay", ko = "아르테미스, 달로 돌아가 오래 머물러요" },
    ["fact.badge"] = { en = "Did you know?", ko = "알고 있나요?" },
    ["fact.donki.body"] = { en = "NASA keeps a database called DONKI that records space weather events, like solar flares, solar energetic particle events, big clouds of gas from the Sun, and geomagnetic storms. It is run mainly by the Moon-to-Mars Space Weather Analysis Office at NASA's Goddard Space Flight Center. In this game, the alerts replay real events from the past, and we show their real dates.", ko = "NASA에는 태양 폭발, 태양 고에너지 입자 사건, 태양이 내뿜은 거대한 가스 구름, 지자기 폭풍 같은 우주 날씨 사건을 기록하는 DONKI라는 데이터베이스가 있어요. NASA 고다드 우주비행센터의 달-화성 우주 기상 분석 사무실이 주로 운영해요. 이 게임의 알림은 과거에 실제로 있었던 일을 다시 보여 주는 것이고, 실제 날짜도 함께 보여 줘요." },
    ["fact.donki.title"] = { en = "Where does the space weather come from?", ko = "우주 날씨는 어디서 올까요?" },
    ["fact.geomagnetic.body"] = { en = "A geomagnetic storm is a big disturbance of Earth's magnetic field, the huge invisible bubble around our planet. The biggest ones come from huge clouds of gas thrown out by the Sun, and they can cause mistakes in GPS (the system that finds locations), disturb radio signals, and cause problems for power grids on Earth. The Moon has no global magnetic field like Earth's, so the trouble shows up on the Earth side.", ko = "지자기 폭풍은 지구 자기장, 곧 지구를 둘러싼 보이지 않는 커다란 방패가 크게 흔들리는 현상이에요. 가장 큰 폭풍은 태양이 내뿜은 거대한 가스 구름 때문에 생기고, 지구에서 GPS(위치를 알려 주는 시스템) 오차, 무선 통신 방해, 전력망 문제를 일으킬 수 있어요. 달에는 지구 같은 전 지구적 자기장이 없어서, 이런 문제는 지구 쪽에서 나타나요." },
    ["fact.geomagnetic.title"] = { en = "When Earth's magnetic bubble shakes", ko = "지구 자기장이 크게 흔들릴 때" },
    ["fact.gravity.body"] = { en = "Gravity on the Moon is one-sixth of Earth's gravity. A kid who weighs 30 kilograms on Earth would weigh only about 5 kilograms on the Moon.", ko = "달 표면의 중력은 지구의 6분의 1이에요. 지구에서 몸무게가 30kg인 어린이는 달에서 약 5kg으로 느껴져요." },
    ["fact.gravity.title"] = { en = "The Moon is much lighter", ko = "달에서는 몸이 훨씬 가벼워요" },
    ["fact.grow_lights.body"] = { en = "Plants use mostly red and blue light, and they reflect a lot of green light. So the LED lights (small, bright lamps) above NASA's Veggie space garden are chosen for what plants use, and the chamber typically glows magenta pink. Another space garden, the Advanced Plant Habitat, uses red, blue and green LEDs.", ko = "식물은 주로 빨간빛과 파란빛을 쓰고, 초록빛은 많이 반사해요. 그래서 NASA의 우주 정원 '베지' 위에는 식물에게 맞춘 LED 조명(작고 밝은 전등)이 달려 있고, 식물 방이 보통 자홍빛 분홍색으로 빛나요. 또 다른 우주 정원인 '어드밴스드 플랜트 해비타트'는 빨강, 파랑, 초록 LED를 써요." },
    ["fact.grow_lights.title"] = { en = "Why does the space garden glow pink?", ko = "우주 정원은 왜 분홍색으로 빛날까요?" },
    ["fact.hydroponics.body"] = { en = "NASA tested a space garden called XROOTS that grows plants without soil. It uses hydroponics (roots sit in water with plant food) and aeroponics (roots are misted with water and plant food). Astronauts on the space station harvested tomatoes grown this way.", ko = "NASA는 흙 없이 식물을 기르는 우주 정원 'XROOTS'를 시험했어요. 수경 재배(뿌리를 영양분이 든 물에 담가 기르는 방법)와 분무 재배(뿌리에 영양분이 든 물안개를 뿌려 기르는 방법)를 써요. 우주정거장의 우주비행사들이 이 방법으로 자란 토마토를 수확했어요." },
    ["fact.hydroponics.title"] = { en = "Gardening without soil", ko = "흙 없이 키우는 정원" },
    ["fact.isru.body"] = { en = "Shipping everything from Earth is very hard, so NASA wants to use resources found where astronauts go. This idea is called ISRU, short for in-situ resource utilization, which means using local resources. Moon ice could give astronauts water to use, and NASA is studying how to split water into oxygen and hydrogen to make rocket fuel.", ko = "필요한 물건을 모두 지구에서 실어 나르는 일은 아주 어려워요. 그래서 NASA는 우주비행사가 가는 곳에서 구할 수 있는 자원을 쓰려고 해요. 이것을 ISRU(현지 자원 활용)라고 불러요. 달의 얼음은 우주비행사가 쓸 물이 될 수 있고, NASA는 물을 산소와 수소로 나눠 로켓 연료를 만드는 방법도 연구하고 있어요." },
    ["fact.isru.title"] = { en = "Using what the Moon already has", ko = "달에 있는 것을 가져다 써요" },
    ["fact.lcross.body"] = { en = "In 2009, a NASA spacecraft called LCROSS crashed its rocket stage into Cabeus, a crater at the Moon's south pole, on purpose. Four minutes later, LCROSS itself flew through the cloud of dust that rose up and measured it. Scientists reported that LCROSS found water there.", ko = "2009년에 NASA의 우주선 LCROSS는 로켓 상단부를 일부러 달 남극의 카베우스(Cabeus) 크레이터에 충돌시켰어요. 4분 뒤 LCROSS가 솟아오른 먼지 구름 속을 날아가며 성분을 조사했어요. 과학자들은 그곳에서 물을 찾았다고 발표했어요." },
    ["fact.lcross.title"] = { en = "The crash that found water", ko = "물을 찾아낸 우주선 충돌" },
    ["fact.lunar_day.body"] = { en = "Near the Moon's equator, daylight lasts about 14 Earth days, and then the night lasts about 14 more. Near the south pole, the Sun circles close to the horizon and never climbs high in the sky. Some high ridges stay sunny for much longer, which makes them good places for solar panels.", ko = "달의 적도 근처에서는 낮이 지구 시간으로 약 14일 이어지고, 그다음 밤도 약 14일 이어져요. 남극 근처에서는 해가 지평선 가까이에서 빙글빙글 돌고 하늘 높이 올라가지 않아요. 높은 능선 중에는 훨씬 오래 햇빛을 받는 곳이 있어서 태양광 패널을 놓기에 좋아요." },
    ["fact.lunar_day.title"] = { en = "A very long day on the Moon", ko = "달의 하루는 아주 길어요" },
    ["fact.mission_control.body"] = { en = "Mission Control at NASA's Johnson Space Center in Houston is staffed 24 hours a day by flight controllers. One person there, called the capcom (short for capsule communicator), talks with the astronauts. Mission Control also oversees NASA's Artemis missions on their trips to the Moon and back.", ko = "미국 휴스턴 NASA 존슨 우주센터의 미션 컨트롤은 비행 관제사들이 하루 24시간 일하는 곳이에요. 그중 '캡콤'(우주선 교신 담당)이 우주비행사와 직접 이야기를 나눠요. 미션 컨트롤은 아르테미스 임무가 달에 갔다 오는 동안에도 지켜보며 도와줘요." },
    ["fact.mission_control.title"] = { en = "The team on the ground", ko = "지상에서 돕는 팀" },
    ["fact.plant_water.body"] = { en = "In space, every drop of water counts. NASA's Advanced Plant Habitat, a space garden, handles its water recovery and distribution automatically. On the space station, the crew's life support system can now recover about 98% of the water, almost all of it, from urine, sweat and breath moisture.", ko = "우주에서는 물 한 방울도 소중해요. NASA의 우주 정원 '어드밴스드 플랜트 해비타트'는 물을 되찾고 나눠 주는 일을 자동으로 해요. 국제우주정거장의 생명 유지 장치는 소변, 땀, 숨에서 나온 수분에서 물의 약 98%, 거의 전부를 다시 찾아 쓸 수 있어요." },
    ["fact.plant_water.title"] = { en = "Every drop of water counts", ko = "물 한 방울도 소중해요" },
    ["fact.rover_driving.body"] = { en = "On Mars, radio signals take too long to steer a rover with a joystick, so NASA's Perseverance rover uses cameras and 3D maps to plan its own path around hazards. NASA's Moon rovers, called Lunar Terrain Vehicles, or LTVs, will be driven by Artemis astronauts. When no astronauts are there, they will be driven remotely from Earth.", ko = "화성에서는 신호가 오가는 데 시간이 너무 오래 걸려서 조이스틱으로 로버를 조종할 수 없어요. 그래서 NASA의 퍼서비어런스 로버는 카메라와 3D 지도로 위험한 곳을 피하는 길을 스스로 계획해요. 달 탐사 로버(LTV)는 아르테미스 우주비행사가 직접 운전하고, 우주비행사가 없을 때는 지구에서 원격으로 운전할 계획이에요." },
    ["fact.rover_driving.title"] = { en = "Rovers that drive themselves, and rovers we steer", ko = "스스로 달리는 로버, 우리가 모는 로버" },
    ["fact.sep.body"] = { en = "A big eruption on the Sun can shoot out tiny particles at very high speed, called solar energetic particles, or SEP. They can cross the space from the Sun to Earth in as little as tens of minutes, and a storm can last hours to days. The Moon has no global magnetic field (the invisible bubble that helps protect Earth) and only a very thin atmosphere, so astronauts outside can be in danger.", ko = "태양에서 큰 폭발이 일어나면 아주 작은 입자들이 엄청난 속도로 튀어나올 수 있어요. 이것을 태양 고에너지 입자, 줄여서 SEP라고 해요. 이 입자는 태양에서 지구까지 짧게는 수십 분 만에 날아올 수 있고, 폭풍은 몇 시간에서 며칠까지 이어져요. 달에는 지구를 지켜 주는 보이지 않는 방패 같은 전 지구적 자기장이 없고 대기도 아주 얇아서, 밖에 있는 우주비행사는 위험할 수 있어요." },
    ["fact.sep.title"] = { en = "Fast particles from the Sun", ko = "태양에서 오는 빠른 입자" },
    ["fact.sep_shelter.body"] = { en = "Orion is the spaceship that carries Artemis astronauts. It has a sensor that warns the crew about a radiation storm, and the crew has up to about an hour to build a shelter from stowage bags, which put extra material between them and the radiation. They might need to stay inside for as long as 24 hours.", ko = "오리온은 아르테미스 우주비행사를 태우고 가는 우주선이에요. 방사선 폭풍이 오면 경보 장치가 알려 주고, 승무원은 약 한 시간 안에 짐 가방을 쌓아 대피 공간을 만들어요. 가방이 방사선과 사람 사이에 물질을 더해 주고, 상황에 따라 최대 24시간까지 그 안에 머물러야 할 수 있어요." },
    ["fact.sep_shelter.title"] = { en = "Hide behind a wall of bags", ko = "짐 가방으로 쌓는 방패" },
    ["fact.shadowed_ice.body"] = { en = "The Moon is tilted by only about 1.5 degrees, so sunlight never reaches the floors of some craters near the poles. These dark, very cold places are called permanently shadowed regions. Water that gets into them may stay frozen for a very long time.", ko = "달은 기울어진 정도가 약 1.5도뿐이라서, 극지방 가까이에 있는 어떤 크레이터 바닥에는 햇빛이 한 번도 닿지 않아요. 이렇게 어둡고 아주 추운 곳을 '영구 음영 지역'이라고 불러요. 이곳에 들어간 물은 아주 오랫동안 얼음으로 남아 있을 수 있어요." },
    ["fact.shadowed_ice.title"] = { en = "Craters that never see the Sun", ko = "해가 한 번도 비치지 않는 크레이터" },
    ["fact.source"] = { en = "Based on public NASA information", ko = "NASA 공개 자료 기반" },
    ["fact.south_pole.body"] = { en = "Near the Moon's south pole, the Sun hangs low over the horizon, and some high spots stay sunny for a long time. Some deep craters never see sunlight at all, and NASA missions have found signs of ice in some of them. That is one reason NASA plans to build a Moon Base near the south pole.", ko = "달의 남극 근처에서는 해가 지평선 가까이에 낮게 떠 있고, 높은 곳 중에는 햇빛을 아주 오래 받는 곳이 있어요. 깊은 크레이터 중에는 햇빛이 전혀 닿지 않는 곳도 있는데, NASA 탐사선이 그 가운데 일부에서 얼음의 흔적을 찾았어요. 이것이 NASA가 남극 근처에 달 기지(Moon Base)를 지으려는 이유 중 하나예요." },
    ["fact.south_pole.title"] = { en = "Why the south pole?", ko = "왜 달의 남극일까요?" },
    ["fact.space_garden.body"] = { en = "Astronauts on the International Space Station have grown lettuce and other plants in a small garden called Veggie. Some of the plants were picked and eaten by the crew, and the food was safe. Plants can also help astronauts stay happy and healthy on long trips.", ko = "국제우주정거장의 우주비행사들은 '베지(Veggie)'라는 작은 정원에서 상추 같은 식물을 길렀어요. 그중 일부는 수확해서 직접 먹었고, 안전한 음식이었어요. 식물은 긴 우주여행에서 우주비행사의 마음과 몸을 건강하게 지키는 데도 도움이 돼요." },
    ["fact.space_garden.title"] = { en = "Fresh food from a space garden", ko = "우주 정원에서 얻은 신선한 음식" },
